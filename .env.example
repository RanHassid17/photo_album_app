# Copy to `.env` and fill in. Never commit `.env`.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://album:album@localhost:5432/album

# --- Redis / Celery (matches docker-compose.yml) ---
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
# Where photo originals and thumbnails are written on disk.
PHOTO_STORAGE_DIR=./photo_storage
EXPORT_DIR=./exports

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite reads VITE_-prefixed vars) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
